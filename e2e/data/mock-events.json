"id": "c0adcf09-7773-4ddf-8b24-fd892f05072b", "place":{"id": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "name": "Spinning @ Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8faa748d-f704-492f-b05a-8bb89c9a522a", "name": "Tanec/Pohyb", "name_EN":"Dance/Movement", "color": "#E3D08C"}, "name": "Freestyle Movement – Body Awareness & Musicality", "name_EN": "Freestyle Movement – Body Awareness & Musicality", "name_Secondary": "Liquid Circus (Alan)", "description": "IG: @liquid.circus, Co sebou: Sebe\r\nV tomto workshopu prozkoumáme ovládání těla a přirozené tvary, které naše těla vytvářejí pohybem. Vycházíme z poppingu, animace a mávání a ponoříme se do technik, které nám pomohou vyjádřit hudbu jasněji a kreativněji. Zaměříme se na muzikálnost a osobní interpretaci prostřednictvím pohybu.", "description_EN": "IG: @liquid.circus, What to bring: Yourself\r\nIn this workshop, we’ll explore body control and the natural shapes our bodies create through movement. Drawing from popping, animation, and waving, we’ll dive into techniques to help express music more clearly and creatively. We'll focus on musicality and personal interpretation through movement.", "start": "2025-08-15T12:00:00+02:00", "end": "2025-08-15T13:30:00+02:00", "image": "", "placeId": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "typeId": "8faa748d-f704-492f-b05a-8bb89c9a522a", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
},{"id": "c0d8a67f-ad0f-4337-affe-86daf3b41b0a", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "Zartan", "name_EN": "Zartan", "name_Secondary": "", "description": ".", "description_EN": ".", "start": "2025-08-14T21:30:00+02:00", "end": "2025-08-14T23:00:00+02:00", "image": "", "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []},{
"id": "c107e6de-7146-47ab-9b45-27969cff66cf", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "FocusFire", "name_EN": "FocusFire", "name_Secondary": "", "description": "Electrobone neboli DJ FocusFire je životní umělec, který začal své zkušenosti přenášet do hudebních příběhů od roku 2000. Zjištění, že produkce a mixování je docela zábavná věc, ho přimělo začít přetvářet svůj přirozený hudební tok do autentické produkce. Nejprve několik let experimentoval s tvrdými zvuky jako Tekno a Acid. Po změně vkusu produkoval album Dubstep, poté ve svých produkcích od roku 2009 vyzkoušel různé žánry od Drum&Bass po Chillout a od Ambient Dub po Psy-trance. Od roku 2010 ho to přitáhlo k DJingu široké škály žánrů jako Worldmusic, Future Bass, Tribal, Soulfull a Ecstatic music. V poslední době byl viděn jako DJ na festivalech Flowarts po celé Evropě a na dalších akcích v Nizozemsku.", "description_EN": "Electrobone or DJ FocusFire is a life-artist who started transfering his experiences into musical stories since 2000. Discovering that producing and mixing was quite a fun thing made him start transforming his natural musical flow into authentic productions. First he experimented some years with hard sounds like Tekno and Acid. After a change of taste he produced a Dubstep album, then tried a variety of genres from Drum&Bass to Chillout and from Ambient Dub to Psy-trance in his productions from 2009 onwards. Since 2010 he got drawn to DJ'ing a wide variety of genres like Worldmusic, Future Bass, Tribal, Soulfull and Ecstatic music. Lately he has been seen as a DJ on Flowarts festivals throughout Europe and at other events in the Netherlands.", "start": "2025-08-15T00:30:00+02:00", "end": "2025-08-15T02:00:00+02:00", "image": "", "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
},{
"id": "c3827890-dbe2-497e-85c3-8b554cf4aff4", "place":{"id": "0a759b58-84dc-46c3-9833-4a1c4b80b84c", "name": "Aerial Dome", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "805ca0a6-de05-4fee-a0ea-61602e8a2559", "name": "Aerial", "name_EN":"Aerial", "color": "#92CBFF"}, "name": "Aerial Raknamycs", "name_EN": "Aerial Raknamycs", "name_Secondary": "Fuego Rojo", "description": "We’ll break espectacular movements into pieces, remembering the roots. We’ll work on the sensations of different transitions. We’ll dance between the floor and the air without too much of our minds but indeed through our emotions. After all, we’ll learn how to use movement as a medicine and heal together!\n", "description_EN": "IG: @Raknamycs\n\nWe’ll break espectacular movements into pieces, remembering the roots. We’ll work on the sensations of different transitions. We’ll dance between the floor and the air without too much of our minds but indeed through our emotions. After all, we’ll learn how to use movement as a medicine and heal together!\n", "start": "2025-08-16T15:00:00+02:00", "end": "2025-08-16T16:30:00+02:00", "image": "", "placeId": "0a759b58-84dc-46c3-9833-4a1c4b80b84c", "typeId": "805ca0a6-de05-4fee-a0ea-61602e8a2559", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
