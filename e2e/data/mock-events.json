events:"[{"id":"00ae419f-9cb5-4de4-9e8f-87e2a8239138","place":{"id":"5db9a114-6861-494a-9ba5-abc0f93ac6e8","name":"Meadow","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"1617d663-ed2a-4d11-80e3-a6159dda7ada","name":"Fans","name_EN":"Fans","color":"#ff5252"},"name":"SIlk Fans Choreo","name_EN":"SIlk Fans Choreo","name_Secondary":"Valentina wms","description":"\nIG: @valentina.wsm, Co si s sebou přinést: Hedvábné vějíře\nNaučte se choreografii s hedvábnými vějíři, osvojte si vizuální efekty, rychlosti, obraty a staňte se s nimi jedním z nich.","description_EN":"IG: @valentina.wsm, What to bring: Silk Fans\nLearn a choreography with silk fans, learn some visual effects, velocities, turns and become one with them ","start":"2025-08-17T12: 00:00+02: 00","end":"2025-08-17T13:30: 00+02: 00","image":"","placeId":"5db9a114-6861-494a-9ba5-abc0f93ac6e8","typeId":"1617d663-ed2a-4d11-80e3-a6159dda7ada","tags":[{"id":"eebd10bd-28bb-4444-8257-45487aba7c35","name":"Všechny úrovně","name_EN":"Open Level"}]},{"id":"02a2e4f8-99cc-407d-9ca0-8ffeffb038b6","place":{"id":"78007c5c-0e02-4b1b-b364-86bfedf1ba99","name":"Circus Tent","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"eb6f9406-ec4e-4362-bc82-4a0e494fb189","name":"Show","name_EN":"Show","color":"#e99998"},"name":"Catherine Cignac - Sand Art","name_EN":"Catherine Cignac - Sand Art","name_Secondary":"","description":"Catherine Gignac je písečná umělkyně z Quebecu v Kanadě. Od roku 2019 vytváří písková umělecká představení — vzácnou a poetickou formu vyjádření, kde živě kreslí pískem na světelném stole, vedená hudbou. Její kresby ožívají a proměňují se před očima diváků, promítané na velké plátno ve fascinujícím vizuálním jazyce beze slov. Studovala výtvarná umění na School of Fine Arts v Montrealu a ve Florencii v Itálii a je držitelkou vyznamenání francouzské literatury na McGill University. Catherine hledá krásu a poezii ve všech věcech. Miluje útěk daleko, daleko – unášena představivostí a zvukem hudby, s pískem jako jejím jediným zavazadlem... vyprávěním příběhů, které mizí.\r\n\r\nJejí nejnovější tvorba, Tanec stínů (2025), je její první celovečerní sólovou show. Předtím vytvořila Rêves de sable (2024), krátký pískový kousek, a podílela se na filmu Frétillant et agile (2023), který příběh ilustruje živě. Kromě své jevištní práce produkuje Catherine také písková umělecká videa a trvalé pískové kresby. V roce 2023 se stala finalistkou grantů ForCGal, které oceňují inovace ve výtvarném umění, za video Carnival.\r\n\r\n","description_EN":"Catherine Gignac is a sand artist from Quebec, Canada. Since 2019, she has been creating sand art performances — a rare and poetic form of expression where she draws live with sand on a light table, guided by music. Her drawings come to life and transform before the audience’s eyes, projected on a large screen in a fascinating, wordless visual language. She studied Fine Arts at the School of Fine Arts of Montreal and in Florence, Italy, and holds an honours degree in French literature from McGill University. Catherine seeks beauty and poetry in all things. She loves to escape far, far away — carried by imagination and the sound of music, with sand as her only baggage… telling stories that fade away.\r\n\r\nHer latest creation, Dance of the Shadows (2025), is her first full-length solo show. She previously created Rêves de sable (2024), a short sand piece, and participated in Frétillant et agile (2023), illustrating the story live. Alongside her stage work, Catherine also produces sand art videos and permanent sand drawings. In 2023, she was a finalist for the ForCGal Grants, which recognize innovation in the visual arts, for her video piece Carnival.\r\n\r\n","start":"2025-08-15T23: 30: 00.0000000+02: 00","end":"2025-08-16T01: 00: 00.0000000+02: 00","image":null,"placeId":"78007c5c-0e02-4b1b-b364-86bfedf1ba99","typeId":"eb6f9406-ec4e-4362-bc82-4a0e494fb189","tags":[]},{"id":"04232878-cc69-4bd2-b18f-59f4bd18f7c0","place":{"id":"f15dabd2-1383-4338-8a1f-06686ae32ad9","name":"Psylo Tent","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"ae9f94a9-6dc0-479e-a445-1129a113627f","name":"Juggling","name_EN":"Juggling","color":"#AEA994"},"name":"Claymotion Juggling","name_EN":"Claymotion Juggling","name_Secondary":"Seitan","description":"IG: , Co sebou: Žonglovací míčky\r\nClaymotion žonglování je speciální druh žonglování podobný multiplexu, snadno se učí a je velmi efektivní.","description_EN":"IG: , What to bring: Juggling Balls\r\nClaymotion juggling is special type of juggling similar to multiplex, easy to learn and very effective.","start":"2025-08-14T15: 00:00.0000000+02: 00","end":"2025-08-14T16:30: 00.0000000+02: 00","image":null,"placeId":"f15dabd2-1383-4338-8a1f-06686ae32ad9","typeId":"ae9f94a9-6dc0-479e-a445-1129a113627f","tags":[{"id":"ba7623dc-5239-49d6-9b7c-5a56d8bf4b02","name":"Začátečníci","name_EN":"Beginner"}]},{"id":"04d46610-6bc3-4fe2-bbb1-2ba21fcf44f6","place":{"id":"f15dabd2-1383-4338-8a1f-06686ae32ad9","name":"Psylo Tent","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"2ed042bf-ef98-4293-8cf5-663007bd2911","name":"Hoops","name_EN":"Hoops","color":"#ED76B0"},"name":"Beginner Hoop Flow","name_EN":"Beginner Hoop Flow","name_Secondary":"Aimée","description":"IG: @Aimeelunefleur_performer, Co sebou: Obruče\r\nV tomto workshopu prozkoumáme, jak se spojit s obručí a začít objevovat svůj vlastní jedinečný styl a tok. Prostřednictvím řízených cvičení a hravého pohybu si vybudujete sebevědomí a kreativitu – bez ohledu na vaši úroveň. Lekci zakončíme jednoduchou, ale uspokojivou sekvencí, aby všichni odcházeli s pocitem úspěchu a inspirace.","description_EN":"IG: @Aimeelunefleur_performer, What to bring: Hoops\r\nIn this workshop, we'll explore how to connect with the hoop and begin to discover your own unique style and flow. Through guided exercises and playful movement, you’ll build confidence and creativity—no matter your level. We’ll finish the class with a simple yet satisfying sequence so everyone leaves with a sense of achievement and inspiration.","start":"2025-08-14T13:30:00.0000000+02:00","end":"2025-08-14T15:00:00.0000000+02:00","image":null,"placeId":"f15dabd2-1383-4338-8a1f-06686ae32ad9","typeId":"2ed042bf-ef98-4293-8cf5-663007bd2911","tags":[{"id":"ba7623dc-5239-49d6-9b7c-5a56d8bf4b02","name":"Začátečníci","name_EN":"Beginner"}]},{"id":"06d0e5ca-d6d9-4ec4-a760-8485f35ca3be","place":{"id":"23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022","name":"Fire Space","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"caa27447-9336-402c-b8f7-b00b8b5476f8","name":"DJ","name_EN":"DJ","color":"#c9daf8"},"name":"MysticAya & May-Ah","name_EN":"MysticAya & May-Ah","name_Secondary":"","description":"MysticAya** je brazilský producent a DJ na poslání spojit posvátné a zvukové. Vychází ze svých domorodých kořenů a vytváří pohlcující zvukové plochy, kde se kmenové rytmy střetávají s hlubokými, pulzujícími basy, ve směsi Psybass, Tribal Dub, Dubstep, D&B…\r\n\r\nPro MysticAya je hudba víc než zvuk, je to most mezi světy. Každá sada je pečlivě tkaná cesta, navržená tak, aby probudila tělo i ducha. Zatímco jeho partnerka May-ah přidává své okouzlující živé vokály, mění každé vystoupení v rituál pohybu a spojení.\r\n\r\nPo čtyřech letech utváření svého zvuku v australské undergroundové scéně, zanechání stopy na festivalech jako Burning Seed, Dragon Moom, Initiation, archaická shromáždění, nyní přináší své Cesty do Evropy a intimní taneční ceremonie. Ať už na festivalovém pódiu nebo ve spoře osvětleném klubu, jeho hudba vás zve odhodit všední den a odevzdat se rytmu\r\n","description_EN":"MysticAya** is a Brazilian Producer and DJ on a mission to merge the sacred and the sonic. Drawing from his Indigenous roots, he crafts immersive soundscapes where tribal rhythms collide with deep, pulsing bass, in s blend of Psybass, Tribal Dub, Dubstep, D&B…\r\n\r\nFor MysticAya, music is more than sound, it’s a bridge between worlds. Each set is a carefully woven journey, designed to awaken the body and spirit. While his partner May-ah adds her spellbinding live vocals, turning every performance into a ritual of movement and connection.\r\n\r\nAfter four years shaping his sound in Australia’s underground scene, leaving his mark at festivals like Burning Seed, Dragon Moom, Initiation, archaic gathering, he’s now bringing his Journeys to Europe, and intimate dance ceremonies alike. Whether on a festival stage or in a dimly lit club, his music invites you to shed the everyday and surrender to the rhythm\r\n","start":"2025-08-17T22:00:00+02:00","end":"2025-08-17T23:30:00+02:00","image":"","placeId":"23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022","typeId":"caa27447-9336-402c-b8f7-b00b8b5476f8","tags":[]},{"id":"08ea852f-6193-440d-a2b8-dba72b0c4218","place":{"id":"78007c5c-0e02-4b1b-b364-86bfedf1ba99","name":"Circus Tent","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"eb6f9406-ec4e-4362-bc82-4a0e494fb189","name":"Show","name_EN":"Show","color":"#e99998"},"name":"Matija Solce - Harms","name_EN":"Matija Solce - Harms","name_Secondary":"","description":"Narozen 2.6.1981 ve Slovinsku. Hudebník, loutkář, herec a režisér a také profesor loutkářství, organizátor festivalu a aktivista Matija Solce vystudoval doktorské studium Alternativního divadla a loutkářství na pražské divadelní akademii (DAMU) na téma „Hudební perspektiva loutkového divadla“. Ve své tvorbě úzce propojuje hudbu a divadlo, a proto se jeho koncerty často mění v interaktivní divadelní představení nebo se z jeho loutkových představení stávají hudební kompozice. S harmonikou a kufrem plným loutek procestoval celý svět a zažil tak extrémní místa, jako jsou vězení, ášramy, ložnice lidí nebo velké sály mezinárodních festivalů. Dosud byl oceněn více než 20krát.\r\n","description_EN":"Born 2.6.1981 in Slovenia. Musician, puppeteer, actor and director as well as puppetry proffesor, festival organiser and activist, Matija Solce, finished doctour studies on Alternative Theatre and Puppetry at the Prague theatre academy (DAMU), on the theme of “The musical perspective of puppet theatre”. In his works he closely connects music and theatre, and therefore his concerts often turn into interactive theatre performances, or his puppet shows become musical compositions. With his accordion and suitcase full of puppets he travelled the globe, experiencing venues as extreme as prisons, ashrams, people’s bedrooms or big halls of international festivals. So far he was awarded over 20 times.\r\n","start":"2025-08-17T18:30:00.0000000+02:00","end":"2025-08-17T19:30:00.0000000+02:00","image":null,"placeId":"78007c5c-0e02-4b1b-b364-86bfedf1ba99","typeId":"eb6f9406-ec4e-4362-bc82-4a0e494fb189","tags":[]},{"id":"0b654a62-90d2-44ff-bd0d-de2f6cfc8d1c","place":{"id":"2ed3e877-836d-4f11-9965-ff31c9ccb455","name":"Spinning @ Tent","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"ae6c4550-5f1e-4ffb-8b81-f88e4668f40a","name":"Yoga","name_EN":"Yoga","color":"#FFB451"},"name":"Elemental Yoga Fusion & Flow","name_EN":"Elemental Yoga Fusion & Flow","name_Secondary":"Luke (Elemental Fusion)","description":"IG: @Elemental_Fusion_Yoga_Flow, Co sebou: Podložka na jógu, pohodlné oblečení na pohyb a láhev s vodou.\r\nV této hodině ranní jógy prozkoumáme prvky vinyasa jógy v kombinaci s pohybovou prací, emocionálním uvolněním a aktivací hlasu, abychom pomohli mysli a tělu proudit do dalšího dne.","description_EN":"IG: @Elemental_Fusion_Yoga_Flow, What to bring: Yoga mat, comfy clothes to move in and water bottle.\r\nIn this Morning Yoga class we will explore elements of vinyasa yoga combined with mobility work, emotional release and voice activation to help get the mind and body flowing into the day ahead.","start":"2025-08-16T09:00:00.0000000+02:00","end":"2025-08-16T10:30:00.0000000+02:00","image":null,"placeId":"2ed3e877-836d-4f11-9965-ff31c9ccb455","typeId":"ae6c4550-5f1e-4ffb-8b81-f88e4668f40a","tags":[{"id":"ba7623dc-5239-49d6-9b7c-5a56d8bf4b02","name":"Začátečníci","name_EN":"Beginner"}]},{"id":"0cfae4b2-bcaa-493c-b3b8-75857b543a6c","place":{"id":"7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18","name":"Tchaiovna","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"fecad87f-08cd-48ef-952c-b72fdc3fe775","name":"Live music","name_EN":"Live music","color":"#43e90c"},"name":"Kristof & Jan elf beatbox live looping ","name_EN":"Kristof & Jan elf beatbox live looping ","name_Secondary":"","description":"","description_EN":"","start":"2025-08-17T22:30:00.0000000+02:00","end":"2025-08-18T02:30:00.0000000+02:00","image":null,"placeId":"7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18","typeId":"fecad87f-08cd-48ef-952c-b72fdc3fe775","tags":[]},{"id":"0e3f2c39-aa88-4bbf-8442-d01dd5d22436","place":{"id":"1c157563-cf57-4020-b024-7883d2897d94","name":"Sunset Stage","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"fecad87f-08cd-48ef-952c-b72fdc3fe775","name":"Live music","name_EN":"Live music","color":"#43e90c"},"name":"Silaabaa ","name_EN":"Silaabaa ","name_Secondary":"","description":"Silaabaa ","description_EN":"Silaabaa `","start":"2025-08-15T15:30:00+02:00","end":"2025-08-15T16:30:00+02:00","image":"","placeId":"1c157563-cf57-4020-b024-7883d2897d94","typeId":"fecad87f-08cd-48ef-952c-b72fdc3fe775","tags":[]},{"id":"0e7e8700-c3d7-4805-837f-a79f5f7234f3","place":{"id":"23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022","name":"Fire Space","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"0b6cd902-494b-454b-a291-aa0fb3a0f7d5","name":"Rope dart","name_EN":"Rope dart","color":"#F7DF69"},"name":"Horizontal Trance","name_EN":"Horizontal Trance","name_Secondary":"Marla Nagini","description":"IG: @Marla_nagini, Co sebou: ropedart\nV horizontálním režimu je to místo, kde tělo vytváří vzpomínky a reaguje na harmonizaci rotace. Uvidíme kolébky a jejich nekonečné variace. Jak přidat současné taneční pohyby a trochu akrobacie k našemu horizontálnímu toku. Zajímavý workshop pro ty, kteří se chtějí zúčastnit Partner Rope Dart.","description_EN":"IG: @Marla_nagini, What to bring: ropedart\nIn horizontal mode it’s where the body creates memories and responds to harmonize the rotation. We will see the cradles and their infinite variations. How to add contemporary dance movements and some acrobatics to our horizontal flow. Interesting workshop for those who want to attend the Partner Rope Dart.","start":"2025-08-16T12:00:00+02:00","end":"2025-08-16T13:30:00+02:00","image":"","placeId":"23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022","typeId":"0b6cd902-494b-454b-a291-aa0fb3a0f7d5","tags":[{"id":"45d628ea-15e5-444b-a8a6-b624d86d002b","name":"Středně pokročilí","name_EN":"Intermediate"}]},{"id":"0f08c0e5-aa46-4c7a-a791-cd9ceb9da9f0","place":{"id":"5f32ef9b-d255-4420-95be-101ba551381c","name":"Dock","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"caa27447-9336-402c-b8f7-b00b8b5476f8","name":"DJ","name_EN":"DJ","color":"#c9daf8"},"name":"MysticAya & May-Ah","name_EN":"MysticAya & May-Ah","name_Secondary":"","description":"MysticAya** je brazilský producent a DJ na poslání spojit posvátné a zvukové. Vychází ze svých domorodých kořenů a vytváří pohlcující zvukové plochy, kde se kmenové rytmy střetávají s hlubokými, pulzujícími basy, ve směsi Psybass, Tribal Dub, Dubstep, D&B…\r\n\r\nPro MysticAya je hudba víc než zvuk, je to most mezi světy. Každá sada je pečlivě tkaná cesta, navržená tak, aby probudila tělo i ducha. Zatímco jeho partnerka May-ah přidává své okouzlující živé vokály, mění každé vystoupení v rituál pohybu a spojení.\r\n\r\nPo čtyřech letech utváření svého zvuku v australské undergroundové scéně, zanechání stopy na festivalech jako Burning Seed, Dragon Moom, Initiation, archaická shromáždění, nyní přináší své Cesty do Evropy a intimní taneční ceremonie. Ať už na festivalovém pódiu nebo ve spoře osvětleném klubu, jeho hudba vás zve odhodit všední den a odevzdat se rytmu\r\n\r\n","description_EN":"MysticAya** is a Brazilian Producer and DJ on a mission to merge the sacred and the sonic. Drawing from his Indigenous roots, he crafts immersive soundscapes where tribal rhythms collide with deep, pulsing bass, in s blend of Psybass, Tribal Dub, Dubstep, D&B…\r\n\r\nFor MysticAya, music is more than sound, it’s a bridge between worlds. Each set is a carefully woven journey, designed to awaken the body and spirit. While his partner May-ah adds her spellbinding live vocals, turning every performance into a ritual of movement and connection.\r\n\r\nAfter four years shaping his sound in Australia’s underground scene, leaving his mark at festivals like Burning Seed, Dragon Moom, Initiation, archaic gathering, he’s now bringing his Journeys to Europe, and intimate dance ceremonies alike. Whether on a festival stage or in a dimly lit club, his music invites you to shed the everyday and surrender to the rhythm\r\n\r\n","start":"2025-08-16T22:00:00+02:00","end":"2025-08-16T23:30:00+02:00","image":"","placeId":"5f32ef9b-d255-4420-95be-101ba551381c","typeId":"caa27447-9336-402c-b8f7-b00b8b5476f8","tags":[]},{"id":"101d57e1-20c2-48c9-ae1e-94ead0eb3275","place":{"id":"f15dabd2-1383-4338-8a1f-06686ae32ad9","name":"Psylo Tent","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"1de3301c-fe95-446e-9fcb-b0cd7e056e1d","name":"Contact ball","name_EN":"Contact ball","color":""},"name":"Contact Juggling","name_EN":"Contact Juggling","name_Secondary":"Francesco","description":"IG: , Co sebou: Vezměte si kouli nebo míč s sebou! [každý míč je vítán, lepší, když je větší než tvá pěst]\r\nPro začátečníky i pro ty, kteří kontaktní kouli nikdy nechytili.","description_EN":"IG: , What to bring: Take your sphere or your ball with you! [every ball is welcome, better if it's bigger than your fist]\r\nFor beginners and also for those who have never picked up a contact sphere.","start":"2025-08-16T16: 30: 00+02: 00","end":"2025-08-16T18: 00: 00+02: 00","image":"","placeId":"f15dabd2-1383-4338-8a1f-06686ae32ad9","typeId":"1de3301c-fe95-446e-9fcb-b0cd7e056e1d","tags":[{"id":"ba7623dc-5239-49d6-9b7c-5a56d8bf4b02","name":"Začátečníci","name_EN":"Beginner"}]},{"id":"1148b56c-7457-43ed-903c-431b38ccb1fe","place":{"id":"78007c5c-0e02-4b1b-b364-86bfedf1ba99","name":"Circus Tent","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"8b844ab4-dc39-4323-b647-e93bfb43d2b8","name":"Gala","name_EN":"Gala","color":"#ffe59a"},"name":"Opening Varieté","name_EN":"Opening Varieté","name_Secondary":"","description":"Opening Varieté je naše malé čtvrteční gala, hnedka po zahajovací ceremonii.\r\n\r\nÚČINKUJÍCÍ: \r\nVicky Roman\r\nCharlie Nayler\r\nMarius Dince\r\nOhmega\r\nFernando Torres\r\nBlackout Paradox\r\nAnna Weszelovszky\r\nGuillaume Bellet","description_EN":"The Opening Variete is the little starting Gala on Thursday evening, just after the Great Opening Ceremony.🤟\r\n\r\nLINEUP: \r\nVicky Roman\r\nCharlie Nayler\r\nMarius Dince\r\nOhmega\r\nFernando Torres\r\nBlackout Paradox\r\nAnna Weszelovszky\r\nGuillaume Bellet","start":"2025-08-14T23: 00: 00+02: 00","end":"2025-08-14T23: 00: 00+02: 00","image":"","placeId":"78007c5c-0e02-4b1b-b364-86bfedf1ba99","typeId":"8b844ab4-dc39-4323-b647-e93bfb43d2b8","tags":[]},{"id":"11a0407e-46eb-437b-a963-37dc5675ae91","place":{"id":"11eec21d-ca1d-440c-9222-993490773ee7","name":"Forest","name_EN":"","name_Secondary":"","description":"","description_EN":"","start":null,"end":null,"image":"","placeId":"00000000-0000-0000-0000-000000000000","typeId":"00000000-0000-0000-0000-000000000000","tags":[]},"type":{"id":"ae9f94a9-6dc0-479e-a445-1129a113627f","name":"Juggling","name_EN":"Juggling","color":"#AEA994"},"name":"Trap technique - clubs juggling","name_EN":"Trap technique - clubs juggling","name_Secondary":"Axel","description":"IG: @Axel.circus, Co sebou: Kluby\r\n„Žonglování s klubem: Progresivní průzkum“\r\nV tomto workshopu se ponoříme do základních a kreativních aspektů klubového žonglování se zvláštním zaměřením na rozvoj techniky trapu. Počínaje cvičeními pro začátečníky postupně pokročíme k pokročilejším variantám. Toto sezení je navrženo jako cesta – zkoumání rytmu, rovnováhy a hravé experimentování s klubem jako rekvizitou i partnerem. Ať už jste s klubovými pastmi noví nebo chcete vylepšit svou techniku, budete odcházet s čerstvou inspirací a novými nástroji pro váš flow.","description_EN":"IG: @Axel.circus, What to bring: Clubs\r\n\"Juggling with Club: A Progressive Exploration\"\r\nIn this workshop, we’ll dive into the foundational and creative aspects of club juggling, with a special focus on developing the trap technique. Starting from beginner-friendly exercises, we’ll gradually progress toward more advanced variations. This session is designed as a journey—exploring rhythm, balance, and playful experimentation with the club as both a prop and a partner. Whether you're new to club traps or looking to refine your technique, you'll leave with fresh inspiration and new tools for your flow.", "start": "2025-08-17T13:30:00.0000000+02:00", "end":"2025-08-17T15:00:00.0000000+02:00", "image": null, "placeId": "11eec21d-ca1d-440c-9222-993490773ee7","typeId": "ae9f94a9-6dc0-479e-a445-1129a113627f", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]},{
"id": "11c362c2-664a-4409-a5cb-cd32a022e006", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "Rocco Racoon", "name_EN": "Rocco Racoon", "name_Secondary": "", "description": "Racoon je zpět! \r\n\r\nV určitém okamžiku začínala být hudba v ohnivém prostoru nudná, a tak se tento Racoon rozhodl zakročit a vydat se na skládku a hledat ty nejšpinavější, nejšpinavější a nejšpinavější melodie, jaké lidstvo zná. Očekávejte spoustu basů, trapných zvuků, doplněných pár dubstepovými sousedícími melodiemi 🙂 Donutím vás se hýbat a vrtět zadkem, je to Racoon Promise!\r\n", "description_EN": "The Racoon is back! \r\n\r\nAt some point firespace music was getting boring, so this Racoon decided to step in and go dumpster diving, looking for the dirtiest, grimiest and filthiest tunes known to mankind. Expect a lot of bass, trappy sounds, rounded up with some dubstep adjacent tunes 🙂 I will make you want to move and shake your ass, it’s a Racoon Promise!\r\n", "start": "2025-08-16T22:00:00.0000000+02:00", "end": "2025-08-16T23:30:00.0000000+02:00", "image": null, "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
},{"id": "13595f8b-6c7b-45cd-8fff-00d12e597501", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "Ima Kokode", "name_EN": "Ima Kokode", "name_Secondary": "", "description": "DJ Ima Kokode", "description_EN": "DJ Ima Kokode", "start": "2025-08-18T01:00:00+02:00", "end": "2025-08-18T02:30:00+02:00", "image": "", "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []},{
"id": "15bf9a9e-6301-40c8-842b-1086e0732f5f", "place":{"id": "11eec21d-ca1d-440c-9222-993490773ee7", "name": "Forest", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8faa748d-f704-492f-b05a-8bb89c9a522a", "name": "Tanec/Pohyb", "name_EN":"Dance/Movement", "color": "#E3D08C"}, "name": "Body Movement for Fire Dancers", "name_EN": "Body Movement for Fire Dancers", "name_Secondary": "Srikanta Barefoot", "description": "IG: @srikanta_barefoot, Co sebou: Hůl, oblečení, které umožňuje svobodu pohybu. Obuv\r\nPřipojte se ke Srikantovi a prozkoumejte taneční techniky a pohyby těla, které lze použít na více rekvizit. Chcete svému výkonu přidat více ladnosti, plynulosti a pohybu těla? Tento učební plán je navržen s ohledem na vás.", "description_EN": "IG: @srikanta_barefoot, What to bring: A staff, clothes which allow freedom of movement. Shoes\r\nJoin Srikanta in exploring dance techniques and body movements which can be applied to multiple props. Looking to add more grace, fluidity and body movement to your performance? This curriculum is designed with you in mind.", "start": "2025-08-16T16:30:00.0000000+02:00", "end": "2025-08-16T18:00:00.0000000+02:00", "image": null, "placeId": "11eec21d-ca1d-440c-9222-993490773ee7", "typeId": "8faa748d-f704-492f-b05a-8bb89c9a522a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
