"id": "ed97c056-9580-440f-a45d-1d725ab08765", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "4bf40ee3-a45a-4446-800f-73f6731d61e9", "name": "Fun", "name_EN":"Fun", "color": "#a64d79"}, "name": "Ding Dong Grand Opening", "name_EN": "Ding Dong Grand Opening", "name_Secondary": "", "description": "Vrh bimbasem!\r\nBimbárium vzniklo jako cirkusová legrácka; klaunský bimbastický opis disciplíny vrhu nožem. Dnes je platformou pro vědomou práci se studem a osvětlování mýtů v mezilidských vztazích. To vše způsobem úsměvným, chcete-li směšným.", "description_EN": "Throw a willy!\r\nBimbarium originated as a circus joke; a clownish bimbastic take on the discipline of knife throwing. Today it is a platform for conscious work with shame and the illumination of myths in interpersonal relationships. All this in an amusing way that is ridiculous, if you will.", "start": "2025-08-14T21:00:00.0000000+02:00", "end": "2025-08-14T22:00:00.0000000+02:00", "image": null, "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "4bf40ee3-a45a-4446-800f-73f6731d61e9", "tags": []
