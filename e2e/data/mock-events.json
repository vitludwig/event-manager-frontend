"id": "7b2e7aa7-ae34-4f17-8da8-967d12ca6c57", "place":{"id": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "name": "Spinning @ Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "ae6c4550-5f1e-4ffb-8b81-f88e4668f40a", "name": "Yoga", "name_EN":"Yoga", "color": "#FFB451"}, "name": "Coordinate and Connect ", "name_EN": "Coordinate and Connect ", "name_Secondary": "Luke (Elemental Fusion)", "description": "IG: @Elemental_Fusion_Yoga_Flow, Co sebou: Sebe\r\nV tomto workshopu prozkoumáme koordinační cvičení a kreativním způsobem zahřejeme tělo. Což pak povede k zábavným partnerským cvičením, která pomohou vytvořit spojení se sebou samým a se svým partnerem.\r\n", "description_EN": "IG: @Elemental_Fusion_Yoga_Flow, What to bring: Yourself\r\nIn this workshop we will be exploring coordination exercises while warming up the body in creative ways. Which will then lead into some fun partner exercises to help create connection with yourself and your partner.\r\n", "start": "2025-08-14T12:00:00.0000000+02:00", "end": "2025-08-14T13:30:00.0000000+02:00", "image": null, "placeId": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "typeId": "ae6c4550-5f1e-4ffb-8b81-f88e4668f40a", "tags": [{"id": "ba7623dc-5239-49d6-9b7c-5a56d8bf4b02", "name": "Začátečníci", "name_EN":"Beginner"}]
},{
"id": "7b7fba1e-7e29-442a-88fc-aa1374b4e18f", "place":{"id": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "name": "Spinning @ Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "ae6c4550-5f1e-4ffb-8b81-f88e4668f40a", "name": "Yoga", "name_EN":"Yoga", "color": "#FFB451"}, "name": "Elemental Yoga Fusion & Flow", "name_EN": "Elemental Yoga Fusion & Flow", "name_Secondary": "Luke (Elemental Fusion)", "description": "IG: @Elemental_Fusion_Yoga_Flow, Co sebou: Podložka na jógu, pohodlné oblečení na pohyb a láhev s vodou.\r\nV této hodině ranní jógy prozkoumáme prvky vinyasa jógy v kombinaci s pohybovou prací, emocionálním uvolněním a aktivací hlasu, abychom pomohli mysli a tělu proudit do dalšího dne.", "description_EN": "IG: @Elemental_Fusion_Yoga_Flow, What to bring: Yoga mat, comfy clothes to move in and water bottle.\r\nIn this Morning Yoga class we will explore elements of vinyasa yoga combined with mobility work, emotional release and voice activation to help get the mind and body flowing into the day ahead.", "start": "2025-08-15T09:00:00.0000000+02:00", "end": "2025-08-15T10:30:00.0000000+02:00", "image": null, "placeId": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "typeId": "ae6c4550-5f1e-4ffb-8b81-f88e4668f40a", "tags": [{"id": "ba7623dc-5239-49d6-9b7c-5a56d8bf4b02", "name": "Začátečníci", "name_EN":"Beginner"}]
