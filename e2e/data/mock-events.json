"id": "61e64da4-c66f-40d4-b3c4-7943e26314e9", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Chi Roll Families", "name_EN": "Chi Roll Families", "name_Secondary": "Jed Fowler", "description": "IG: @mr_jedly, Co sebou: Dragonstaff\r\nTento workshop rozšíří vaše znalosti o chi rolls představením různých typů chi rolls. Probereme horizontální chi rolly, ovládání roviny, jak se dračí hůl pohybuje 4x způsoby, pak některá cvičení pro zvýšení vaší kontroly nad chi rolly a ukážeme, jak se integrují do vertikálních a horizontálních technik dračí hůlky.\r\n", "description_EN": "IG: @mr_jedly, What to bring: Dragonstaff\r\nThis workshop will expand your knowledge of chi rolls by introducing the various chi roll types. We will cover horizontal chi rolls, plane control, how a dragonstaff moves 4x ways, then some exercises to increase your control of chi rolls and show how they integrate into vertical and horizontal dragonstaff techniques.\r\n", "start": "2025-08-15T09:00:00.0000000+02:00", "end": "2025-08-15T10:30:00.0000000+02:00", "image": null, "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
