"id": "79bd8077-a676-44be-9efa-e0f50f24e818", "place":{"id": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "name": "Circus Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Fishtails", "name_EN": "Fishtails", "name_Secondary": "Krista Palm", "description": "IG: @krista.palm, Co si s sebou přinést: Hůl\nV tomto workshopu se naučíte rybí ocasy s jednou a dvěma holemi. Začneme s rybími ocasy vpřed a vzad a postupně se budeme věnovat různým způsobům, jak zahrát dvojité rybí ocasy. Pro pokročilejší účastníky prozkoumáme různé kombinace a případně i pasování. Vítány jsou všechny úrovně.\nPřineste si dvojité nebo dlouhou hůl.", "description_EN": "IG: @krista.palm, What to bring: Staff\nIn this workshop, you’ll learn fishtails with one and two staffs. We’ll start with forward and backward fishtails and progress to different ways to enter double fishtails. For more advanced participants, we’ll explore different combos and possibly passing. All levels are welcome.\nBring double staffs or a long staff.", "start": "2025-08-14T12:00:00+02:00", "end": "2025-08-14T13:30:00+02:00", "image": "", "placeId": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
