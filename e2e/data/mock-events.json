"id": "8b24eac2-7cea-479d-982c-8a0069ef7208", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "1617d663-ed2a-4d11-80e3-a6159dda7ada", "name": "Fans", "name_EN":"Fans", "color": "#ff5252"}, "name": "Fan-x the next evolution of juggling fans", "name_EN": "Fan-x the next evolution of juggling fans", "name_Secondary": "Omertov", "description": "IG: @jugglingfans, Co sebou: přineste si jógamatku, pro všechny zajistím ventilátory\r\n🪭 Workshop fanoušků žonglování s Omertovem 🪭\r\nObjevte, jak žonglovat, proudit a pohybovat se s ventilátory výkonným a plynulým způsobem.\r\nSměs techniky, improvizace a manipulace - otevřená všem úrovním", "description_EN": "IG: @jugglingfans, What to bring: bring a yogamat, I will provide fans for everyone\r\n🪭 Juggling fans Workshop with Omertov 🪭\r\nDiscover how to do juggling , flow, and move with fans in a powerful and fluid way.\r\nA mix of technique ,improvisation and manipulation - open to all levels", "start": "2025-08-16T13:30:00+02:00", "end": "2025-08-16T15:00:00+02:00", "image": "", "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "1617d663-ed2a-4d11-80e3-a6159dda7ada", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
