"id": "3eae2e09-5b63-4cb3-b5d8-85509dca6bee", "place":{"id": "5f32ef9b-d255-4420-95be-101ba551381c", "name": "Dock", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "Kahlix B2B TinozZza", "name_EN": "Kahlix B2B TinozZza", "name_Secondary": "", "description": "Tinozzza & Kahlix – Dva DJs z Mnichova, kteří se setkali na Feuerinsel, pravidelném mnichovském ohnivém jamu a okamžitě se hudebně propojili. Jejich zvuk přináší hluboké vibrace z dubstepu, drum & bass, house a downtempa a vytváří pohlcující a energický zážitek.\r\n", "description_EN": "Tinozzza & Kahlix – Two DJs from Munich who met at Feuerinsel, the regular munich fire jam and instantly connected musically. Their sound delivers deep vibes from dubstep, drum & bass, house and downtempo, creating an immersive and energetic experience.\r\n", "start": "2025-08-17T01:00:00.0000000+02:00", "end": "2025-08-17T02:30:00.0000000+02:00", "image": null, "placeId": "5f32ef9b-d255-4420-95be-101ba551381c", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
},{"id": "3ec3d884-942b-4c71-a34c-2970bd6b7687", "place":{"id": "7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18", "name": "Tchaiovna", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "fecad87f-08cd-48ef-952c-b72fdc3fe775", "name": "Live music", "name_EN":"Live music", "color": "#43e90c"}, "name": "Silaabaa traditional drum", "name_EN": "Silaabaa traditional drum", "name_Secondary": "", "description": "Silaabaa traditional drum", "description_EN": "Silaabaa traditional drum", "start": "2025-08-15T13:30:00+02:00", "end": "2025-08-15T14:30:00+02:00", "image": "", "placeId": "7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18", "typeId": "fecad87f-08cd-48ef-952c-b72fdc3fe775", "tags": []},{
"id": "3f30ac24-9dac-4824-8ba8-1ccd4b55cd3c", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "FRESKO", "name_EN": "FRESKO", "name_Secondary": "", "description": "Žonglér Fresh, narozený ve venezuelském Caracasu, rozvinul v posledních letech svou lásku k vinylům a jejich zvláštnímu zvuku. Svými dokonalými dovednostmi a hudební všestranností své publikum vždy nadchne. Disco hudba byla první hudbou, která ho uchvátila a dnes ji kombinuje s Afro, Funk, Cumbia, Porro, Guaracha, Salsa n Boogaloo, King Latin Beats a dává každému karibskou příchuť typickou pro jeho domovinu.", "description_EN": "Born in Venezuela Caracas, Juggler Fresh has developed, during the last years, his love for vinyls and their special sound. With his impeccable skills and musical versatility, he always thrills his audience. Disco music was the first music that fascinated him and today he combines it with Afro, Funk, Cumbia, Porro, Guaracha, Salsa n Boogaloo, King Latin Beats, giving everyone the Caribbean flavor typical of his homeland.", "start": "2025-08-17T02:30:00.0000000+02:00", "end": "2025-08-17T04:00:00.0000000+02:00", "image": null, "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
