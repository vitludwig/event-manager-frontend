"id": "674562ff-289b-4d81-b5ff-ae038040f7d3", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "fecad87f-08cd-48ef-952c-b72fdc3fe775", "name": "Live music", "name_EN":"Live music", "color": "#43e90c"}, "name": "Drum jam", "name_EN": "Drum jam", "name_Secondary": "", "description": "Bubnové jamy Tribo Fuego jsou místním dvoutýdenním místem, kde se můžete setkat se všemi svými přáteli v tanci a bubnování. Nyní v Roztoči budou bubnovat pro vaši radost a doufají, že se přidáte!", "description_EN": "Tribo Fuego drum jams are the local biweekly place to come meet all your fire dancing and drumming friends. Now at Roztoč, they will drum for your enjoyment and are hoping that you'll join in!", "start": "2025-08-15T19:00:00.0000000+02:00", "end": "2025-08-15T20:00:00.0000000+02:00", "image": null, "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "fecad87f-08cd-48ef-952c-b72fdc3fe775", "tags": []
