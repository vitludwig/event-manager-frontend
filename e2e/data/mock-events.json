"id": "e940ed65-71ff-4898-927f-cfc9a53112c2", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "2a8fa9ce-b0d9-4bea-afb1-e07efd0211de", "name": "Lecture/Performance presence", "name_EN":"Lecture/Performance presence", "color": ""}, "name": "Clowning and physical theatre", "name_EN": "Clowning and physical theatre", "name_Secondary": "Tony Robinson", "description": "IG: @Tonynowherecircus, Co sebou: sebe\r\npojďte si s námi zahrát, zaměříme se na hry, abychom našli a sledovali vaši zvědavost a viděli, jak málo nebo kolik musíte udělat, abyste udrželi pozornost nebo ukázali pocit bez špatné odpovědi.", "description_EN": "IG: @Tonynowherecircus, What to bring: yourself\r\ncome and join us for some play, we'll be focussing on games to find and follow your curiosity and see how little or how much you have to do to keep attention or show a feeling with no wrong answer.", "start": "2025-08-14T16:30:00.0000000+02:00", "end": "2025-08-14T18:00:00.0000000+02:00", "image": null, "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "2a8fa9ce-b0d9-4bea-afb1-e07efd0211de", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
