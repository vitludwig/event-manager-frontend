"id": "be49e52f-78b8-4fcb-ba35-8fc34bf079c7", "place":{"id": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "name": "Circus Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8b844ab4-dc39-4323-b647-e93bfb43d2b8", "name": "Gala", "name_EN":"Gala", "color": "#ffe59a"}, "name": "Gala show", "name_EN": "Gala show", "name_Secondary": "", "description": "Hlavní Gala show festivalu! Umělci, jejíchž videa a tutoriály určitě sledujete někde online, najednou jenom pár metrů od vás... Provázeno nikým jiným než roztočovou superstar Ian Deady! \r\nDorazte brzy a přineste si vodu na pití, stan se naplní hodně rychle!\r\n\r\nÚČINKUJÍCÍ:\r\nIan Deady\r\nJean-sou\r\nAnna Weszelovszky\r\nDaniela Paličková\r\nAleš Hrdlička\r\nAxel Bernard-Bouissières \r\nVan-kim Tran & Cyrille Humen\r\nAmbra\r\nJyoti Supernaturel\r\nLiza Morenko", "description_EN": "The main Gala show of the event! Artists whose tutorials and videos you've been watching on the Internet, just a few meters away... all MC'd by the fabulous Roztoč superstar Ian Deady! Make sure to come early and bring water, the tent fills up quite quick!\r\n\r\nLINEUP:\r\nIan Deady\r\nJean-sou\r\nAnna Weszelovszky\r\nDaniela Paličková\r\nAleš Hrdlička\r\nAxel Bernard-Bouissières \r\nVan-kim Tran & Cyrille Humen\r\nAmbra\r\nJyoti  Supernaturel\r\nLiza Morenko", "start": "2025-08-16T20:30:00.0000000+02:00", "end": "2025-08-16T22:00:00.0000000+02:00", "image": null, "placeId": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "typeId": "8b844ab4-dc39-4323-b647-e93bfb43d2b8", "tags": []
