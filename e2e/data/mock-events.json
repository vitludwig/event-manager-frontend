"id": "92035292-34a3-4f85-b812-9703a8a218a7", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "Kahlix B2B TinozZza", "name_EN": "Kahlix B2B TinozZza", "name_Secondary": "", "description": "Tinozzza & Kahlix – Dva DJs z Mnichova, kteří se setkali na Feuerinsel, pravidelném mnichovském ohnivém jamu a okamžitě se hudebně propojili. Jejich zvuk přináší hluboké vibrace z dubstepu, drum & bass, house a downtempa a vytváří pohlcující a energický zážitek.\r\n", "description_EN": "Tinozzza & Kahlix – Two DJs from Munich who met at Feuerinsel, the regular munich fire jam and instantly connected musically. Their sound delivers deep vibes from dubstep, drum & bass, house and downtempo, creating an immersive and energetic experience.\r\n", "start": "2025-08-15T22:00:00+02:00", "end": "2025-08-15T23:30:00+02:00", "image": "", "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
