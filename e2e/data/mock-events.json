"id": "40dae70b-d7c0-40e2-8d5e-c39d6a0476c0", "place":{"id": "f15dabd2-1383-4338-8a1f-06686ae32ad9", "name": "Psylo Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "cad9ef0a-f382-406d-85fc-e8a7686b7a4f", "name": "Poi", "name_EN":"Poi", "color": "#b4d576"}, "name": "Poi behind the back", "name_EN": "Poi behind the back", "name_Secondary": "Alvin", "description": "IG: , Co sebou: 2 Poi\r\nZa zády. Prozkoumáváme místa, kam mohou Poi jít za našimi zády a zkoušíme to kombinovat s jinými triky a různým načasováním.", "description_EN": "IG: , What to bring: 2 Poi\r\nBehind the back. We explore the places, where the Poi can go behind our back and try to combine it with other tricks and different timings.", "start": "2025-08-14T16:30:00+02:00", "end": "2025-08-14T18:00:00+02:00", "image": "", "placeId": "f15dabd2-1383-4338-8a1f-06686ae32ad9", "typeId": "cad9ef0a-f382-406d-85fc-e8a7686b7a4f", "tags": [{"id": "2866d947-b716-43bb-b71a-1d4d9c5f8800", "name": "Středně až pokročilí", "name_EN":"Intermediate/Advanced"}]
