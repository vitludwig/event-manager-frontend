"id": "9c2a533b-fe6c-4278-aa6e-10cf64c4e401", "place":{"id": "11eec21d-ca1d-440c-9222-993490773ee7", "name": "Forest", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Contact Staff with Acro Elements", "name_EN": "Contact Staff with Acro Elements", "name_Secondary": "Simone / Pyroetnico", "description": "IG: @pyroetnico_, Co sebou: Kontaktujte personál\r\nObraťte se na personál míchající prvky podlahových prací, akrobacie a capoeiry.", "description_EN": "IG: @pyroetnico_, What to bring: Contact staff\r\nContact staff mixing elements of floorwork, acrobatics, and capoeira.", "start": "2025-08-16T10:30:00.0000000+02:00", "end": "2025-08-16T12:00:00.0000000+02:00", "image": null, "placeId": "11eec21d-ca1d-440c-9222-993490773ee7", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
