"id": "b4e57545-1f65-4cef-8916-9d8f94d355f4", "place":{"id": "5db9a114-6861-494a-9ba5-abc0f93ac6e8", "name": "Meadow", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "cad9ef0a-f382-406d-85fc-e8a7686b7a4f", "name": "Poi", "name_EN":"Poi", "color": "#b4d576"}, "name": "Movement and positioning with Poi", "name_EN": "Movement and positioning with Poi", "name_Secondary": "Nimul To Ronto", "description": "IG: @flow_to_all_the_things, Co sebou: Poi\r\nPosouváním rovin a chodidel objevujte více pohybu a tancujte se svými poi.", "description_EN": "IG: @flow_to_all_the_things, What to bring: Poi\r\nShifting planes and feet to discover more movement and dance with your poi.", "start": "2025-08-16T10:30:00.0000000+02:00", "end": "2025-08-16T12:00:00.0000000+02:00", "image": null, "placeId": "5db9a114-6861-494a-9ba5-abc0f93ac6e8", "typeId": "cad9ef0a-f382-406d-85fc-e8a7686b7a4f", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
