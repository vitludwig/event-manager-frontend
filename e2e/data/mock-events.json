"id": "255bfe61-bedf-4093-958f-85fcf57a787e", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "ae9f94a9-6dc0-479e-a445-1129a113627f", "name": "Juggling", "name_EN":"Juggling", "color": "#AEA994"}, "name": "3 ball freestyle and games", "name_EN": "3 ball freestyle and games", "name_Secondary": "Laurin", "description": "IG: @trick0815, Co sebou: koule\r\nZačneme představením a procvičováním některých klasických triků se 3 míčky, jako je Ubox, reverzní kaskáda a továrna... pak uděláme nějaké jednoduché vzory a skončíme u zábavných malých žonglérských her.\r\n", "description_EN": "IG: @trick0815, What to bring: balls\r\nWe will start with introducing and practicing some classic 3ball tricks like Ubox, reverse cascade and factory… than do some easy passing patterns and end up with some funny little juggling games.\r\n", "start": "2025-08-15T12:00:00.0000000+02:00", "end": "2025-08-15T13:30:00.0000000+02:00", "image": null, "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "ae9f94a9-6dc0-479e-a445-1129a113627f", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
