"id": "34a897fa-4916-40a6-9b0f-aad18970c7a4", "place":{"id": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "name": "Circus Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8b844ab4-dc39-4323-b647-e93bfb43d2b8", "name": "Gala", "name_EN":"Gala", "color": "#ffe59a"}, "name": "Aerial gala", "name_EN": "Aerial gala", "name_Secondary": "", "description": "Gala závěsné akrobacie je osobité právě tím, že se téměř celé odehrá nad našimi hlavami. Nádherné, mocné, neuchopitelné, s trochou klaunování uprostřed!\r\n\r\nÚČINKUJÍCÍ:\r\nGaia Ma\r\nIlka Bardoczy\r\nIrene & Livia\r\nFuego Rojo\r\nAltura Circus\r\nPhoebe Ford\r\nAmbra & Jazz\r\nDori Podmaniczky", "description_EN": "The Aerial gala is a very special kind of gala, playing out (mostly) all above our heads. Powerful, beautiful, creative and beyond comprehension, with some silliness sprinkled in the middle!\r\n\r\nLINEUP:\r\nGaia Ma\r\nIlka Bardoczy\r\nIrene & Livia\r\nFuego Rojo\r\nAltura Circus\r\nPhoebe Ford\r\nAmbra & Jazz\r\nDori Podmaniczky", "start": "2025-08-15T16:30:00.0000000+02:00", "end": "2025-08-15T17:30:00.0000000+02:00", "image": null, "placeId": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "typeId": "8b844ab4-dc39-4323-b647-e93bfb43d2b8", "tags": []
},{
"id": "365ae3b9-f0aa-4593-bf62-7b9ecd360006", "place":{"id": "11eec21d-ca1d-440c-9222-993490773ee7", "name": "Forest", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Dragonstaff Stalls", "name_EN": "Dragonstaff Stalls", "name_Secondary": "Sara Luna", "description": "IG: @Sara.luna.lee, Co sebou: Dragonstaff\r\nPojďme si hrát s různými typy stánků a prozkoumat přechody k jiným trikům. Naučte se přidat kontrast ke svému toku a předveďte svou muzikálnost.", "description_EN": "IG: @Sara.luna.lee, What to bring: Dragonstaff\r\nLet's play with different types of stalls and explore transitions to other tricks. Learn to add contrast to your flow and show off your musicality.", "start": "2025-08-16T15:00:00.0000000+02:00", "end": "2025-08-16T16:30:00.0000000+02:00", "image": null, "placeId": "11eec21d-ca1d-440c-9222-993490773ee7", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
