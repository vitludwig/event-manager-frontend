"id": "263c1e82-893c-44a5-bd93-81d2f357aac2", "place":{"id": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "name": "Circus Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8faa748d-f704-492f-b05a-8bb89c9a522a", "name": "Tanec/Pohyb", "name_EN":"Dance/Movement", "color": "#E3D08C"}, "name": "waving & Body Control ", "name_EN": "waving & Body Control ", "name_Secondary": "Ambra", "description": "IG: @ambra_occhipinti\nCo si s sebou přinést: Energii!\n\nZdokonalte svůj pohyb pomocí ovládání těla, vln a technik protahování. Naučte se vést energii skrze paže a vlny těla, plynule je trasovat a protahovat, abyste ve svém tanci vytvořili plynulý a záměrný pohyb.", "description_EN": "IG: @ambra_occhipinti\nWhat to bring: Energy!\n\nRefine your movement with body control, waves, and threading techniques. Learn to guide energy through arms and body waves, seamlessly tracing and threading to create fluid, intentional motion in your dance.", "start": "2025-08-14T16:30:00+02:00", "end": "2025-08-14T18:00:00+02:00", "image": "", "placeId": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "typeId": "8faa748d-f704-492f-b05a-8bb89c9a522a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
