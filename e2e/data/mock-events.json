"id": "f7679ed5-bae6-4fc7-b69e-e43fd9f069ae", "place":{"id": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "name": "Circus Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "64f26ee0-a3e5-422f-9a69-145c81e2d1b9", "name": "ALL PROPS", "name_EN":"ALL PROPS", "color": ""}, "name": "Movement and juggling", "name_EN": "Movement and juggling", "name_Secondary": "Thibault", "description": "IG: @Tibonheur_la_chance, Co sebou: Jakákoli rekvizita\r\nProjdeme několika tanečními a žonglérskými improvizacemi, abychom rozvinuli náš vztah k našemu tělu a předmětu", "description_EN": "IG: @Tibonheur_la_chance, What to bring: Any prop\r\nWe will go through several dance and juggling improvisation, to devellop our relation with our body and the object", "start": "2025-08-14T15:00:00+02:00", "end": "2025-08-14T16:30:00+02:00", "image": "", "placeId": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "typeId": "64f26ee0-a3e5-422f-9a69-145c81e2d1b9", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
