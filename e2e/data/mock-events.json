"description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "DJ Ricci", "name_EN": "DJ Ricci", "name_Secondary": "", "description": "...", "description_EN": "...", "start": "2025-08-14T14:00:00+02:00", "end": "2025-08-14T20:00:00+02:00", "image": "", "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []},{
"id": "afb93b1e-31f4-4a51-9ecc-c548c6cde379", "place":{"id": "5db9a114-6861-494a-9ba5-abc0f93ac6e8", "name": "Meadow", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Double staff throws and passes", "name_EN": "Double staff throws and passes", "name_Secondary": "Roberto Morales", "description": "IG: @espejoastral, Co sebou: Dvojitý personál\r\nTento workshop je pro začátečníky a středně pokročilé hráče připravené ponořit se do vzrušujícího světa dvojité hole! Zvládneme dynamické hody, plynulé přihrávky a ty uspokojivé chyty. Pojďme přinést energii a užít si trochu zábavy ve vzduchu!", "description_EN": "IG: @espejoastral, What to bring: Double staff\r\nThis workshop is for beginners and intermediate players ready to dive into the thrilling world of double Staff! We'll be mastering dynamic throws, smooth passes, and those satisfying catches. Let's bring the energy and have some fun in the air!", "start": "2025-08-16T13:30:00+02:00", "end": "2025-08-16T15:00:00+02:00", "image": "", "placeId": "5db9a114-6861-494a-9ba5-abc0f93ac6e8", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "45d628ea-15e5-444b-a8a6-b624d86d002b", "name": "Středně pokročilí", "name_EN":"Intermediate"}]
