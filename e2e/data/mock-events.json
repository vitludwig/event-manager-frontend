"id": "ff8dcc19-5ff9-4200-8342-2cc1ec55efa7", "place":{"id": "5f32ef9b-d255-4420-95be-101ba551381c", "name": "Dock", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "FRESKO", "name_EN": "FRESKO", "name_Secondary": "", "description": "Žonglér Fresh, narozený ve venezuelském Caracasu, rozvinul v posledních letech svou lásku k vinylům a jejich zvláštnímu zvuku. Svými dokonalými dovednostmi a hudební všestranností své publikum vždy nadchne. Disco hudba byla první hudbou, která ho uchvátila a dnes ji kombinuje s Afro, Funk, Cumbia, Porro, Guaracha, Salsa n Boogaloo, King Latin Beats a dává každému karibskou příchuť typickou pro jeho domovinu.", "description_EN": "Born in Venezuela Caracas, Juggler Fresh has developed, during the last years, his love for vinyls and their special sound. With his impeccable skills and musical versatility, he always thrills his audience. Disco music was the first music that fascinated him and today he combines it with Afro, Funk, Cumbia, Porro, Guaracha, Salsa n Boogaloo, King Latin Beats, giving everyone the Caribbean flavor typical of his homeland.", "start": "2025-08-16T23:30:00.0000000+02:00", "end": "2025-08-17T01:00:00.0000000+02:00", "image": null, "placeId": "5f32ef9b-d255-4420-95be-101ba551381c", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
}
