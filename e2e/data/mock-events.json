"id": "366c15a1-96fc-49af-8588-cead9c867468", "place":{"id": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "name": "Circus Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "eb6f9406-ec4e-4362-bc82-4a0e494fb189", "name": "Show", "name_EN":"Show", "color": "#e99998"}, "name": "Renegade show", "name_EN": "Renegade show", "name_Secondary": "", "description": "Show Renegade je něco, co si nemůžete nechat ujít... pojďte předvést, co chcete, a pokud se to bude divákům líbit, možná dostanete drink. Pokud vás někdo nepřebije něčím ještě cool! \r\nNebo tak nějak, slyšel jsem, že asi za hodinu jsou pravidla trochu nejasná... ", "description_EN": "The Renegade show is something you can't just miss... come show off what you want, and if the audience likes it, you might get a drink. Unless someone beats you with something even cooler! \r\nOr something like that, I hear the rules get a little fuzzy about an hour in... ", "start": "2025-08-17T01:00:00.0000000+02:00", "end": "2025-08-17T03:00:00.0000000+02:00", "image": null, "placeId": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "typeId": "eb6f9406-ec4e-4362-bc82-4a0e494fb189", "tags": []
