"id": "907d7241-9b80-4cad-8afd-4cf06a5dd1fd", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "c944a331-5553-4d96-9d54-149d1d952267", "name": "Ostatní", "name_EN":"Other", "color": ""}, "name": "3D Mandala with wool", "name_EN": "3D Mandala with wool", "name_Secondary": "Inke", "description": "IG: , Co sebou: 50 centů za mandaly\r\nVytvoříme 3D mandaly. Naučím vás snadnou techniku s whoolem - možná jste to už viděli na blacklight nebo psytrance parketách. 50 centů za materiály, které vám přivezu, ocením. Info pro naše nejmenší účastníky: Nejsem hlídací stanice, vezměte prosím svého rodiče, který vám v případě potřeby neustále pomáhá. Každý věk je vítán! Prosím, zvažte to. Díky moc! <3", "description_EN": "IG: , What to bring: 50 cents for mandalas\r\nWe will create 3D Mandalas. I'm gonna teach you easy technic with whool - you maybe have seen already on blacklight or psytrance floors. 50 cents for the materials that I will bring for you will be appreciated. Info for our youngest participants: I am not a childcare station, so please bring your parent who constantly helps you if needed. Every age is welcome! Please consider that. Thanks a lot! <3", "start": "2025-08-14T13:30:00+02:00", "end": "2025-08-14T15:00:00+02:00", "image": "", "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "c944a331-5553-4d96-9d54-149d1d952267", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
