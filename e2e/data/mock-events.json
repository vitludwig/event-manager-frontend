"id": "8a33607b-2ae0-4037-8ab1-6923e672f982", "place":{"id": "11eec21d-ca1d-440c-9222-993490773ee7", "name": "Forest", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Geometric patterns", "name_EN": "Geometric patterns", "name_Secondary": "Meast", "description": "IG: @meast__, Co sebou: dvojitý personál\r\nKolekce vzorů dvojitého personálu s partnerskými aplikacemi", "description_EN": "IG: @meast__, What to bring: double staff\r\nCollection of double staff patterns with partner applications", "start": "2025-08-14T16:30:00.0000000+02:00", "end": "2025-08-14T18:00:00.0000000+02:00", "image": null, "placeId": "11eec21d-ca1d-440c-9222-993490773ee7", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
