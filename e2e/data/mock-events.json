"id": "5d2b12f7-2571-4989-a7d2-403df64c2383", "place":{"id": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "name": "Spinning @ Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8faa748d-f704-492f-b05a-8bb89c9a522a", "name": "Tanec/Pohyb", "name_EN":"Dance/Movement", "color": "#E3D08C"}, "name": "Afro Groove", "name_EN": "Afro Groove", "name_Secondary": "Lydia", "description": "Tento taneční workshop zkoumá pohyb skrze rytmy afro a dancehallové hudby. Účastníci se seznámí se základními kroky, groovy a kombinacemi z různých afro stylů a dancehallu se zaměřením na muzikálnost, vnímání těla a vyjadřování. Workshop je otevřený pro všechny úrovně.", "description_EN": "IG: @lychii01\n\nThis dance workshop explores movement through the rhythms of Afro and Dancehall music. Participants will be introduced to foundational steps, grooves, and combinations drawn from various Afro styles and Dancehall, focusing on musicality, body awareness, and expression. Open to all levels.\n", "start": "2025-08-15T13:30:00+02:00", "end": "2025-08-15T15:00:00+02:00", "image": "", "placeId": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "typeId": "8faa748d-f704-492f-b05a-8bb89c9a522a", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
