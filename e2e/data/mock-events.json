"id": "9cb73cef-5662-4c9c-a57a-a1d21cfca98b", "place":{"id": "f15dabd2-1383-4338-8a1f-06686ae32ad9", "name": "Psylo Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8faa748d-f704-492f-b05a-8bb89c9a522a", "name": "Tanec/Pohyb", "name_EN":"Dance/Movement", "color": "#E3D08C"}, "name": "Advanced Tribal Dance", "name_EN": "Advanced Tribal Dance", "name_Secondary": "Tereza Oršulíková", "description": "IG: @terraaqabal\n\nSpojení technik břišního tance a kmenového tance s expresivním pohybem a vyprávěním příběhů umožňuje hlouběji poznat sebe a své tělo, zkoumat funkčnost a estetiku celého těla a zároveň prozkoumávat vnitřní alchymii, která se v tanci odehrává, jemnost a sílu, citlivost, fantazii a představivost. Vhodné pro kohokoli, nejsou potřeba předchozí zkušenosti, pouze vaše zvědavost a ochota objevovat a bavit se.", "description_EN": "IG: @terraaqabal\n\nFusion of belly dance and tribal dance techniques with expressive movement and storytelling allows to get to know yourself and your body on a deeper level, researching functionality and aesthetics of the whole body as well as exploring the inner alchemy happenning in the dance, softness and power, sensitivity, fantasy and imagination. Suitable for anybody, no need for previous experience, only your curiosity and willingness to explore and have fun.", "start": "2025-08-17T12:00:00+02:00", "end": "2025-08-17T13:30:00+02:00", "image": "", "placeId": "f15dabd2-1383-4338-8a1f-06686ae32ad9", "typeId": "8faa748d-f704-492f-b05a-8bb89c9a522a", "tags": []
},{
"id": "9dffcd7e-3cd0-4bb3-8d2f-a1fd1e438178", "place":{"id": "11eec21d-ca1d-440c-9222-993490773ee7", "name": "Forest", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Neck Stalls and transitions in contact Elements", "name_EN": "Neck Stalls and transitions in contact Elements", "name_Secondary": "Liza Morenko", "description": "IG: @oknerom_, Co sebou: Kontaktujte personál\r\nProzkoumáme různé zastávky na krku – jako je svatozář a brada – prováděné bez použití rukou. Pokryjeme techniky provádění a přechody ve stylu kyvadla, které vedou k možnosti vytvoření sekvence kontaktů zaměstnanců bez použití rukou.", "description_EN": "IG: @oknerom_, What to bring: Contact Staff\r\nWe’ll explore different neck-based staff stops — like the halo and chin stall — performed without using the hands. We’ll cover execution techniques and pendulum-style transitions, leading to the possibility of creating a hands-free contact staff sequence.", "start": "2025-08-17T12:00:00.0000000+02:00", "end": "2025-08-17T13:30:00.0000000+02:00", "image": null, "placeId": "11eec21d-ca1d-440c-9222-993490773ee7", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
