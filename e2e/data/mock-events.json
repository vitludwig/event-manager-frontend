"id": "f6b17b01-bb25-4395-a923-a36949e9ded3", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "0b6cd902-494b-454b-a291-aa0fb3a0f7d5", "name": "Rope dart", "name_EN":"Rope dart", "color": "#F7DF69"}, "name": "Sunrise Variations", "name_EN": "Sunrise Variations", "name_Secondary": "Janna Darkari", "description": "IG: @darkari.motion, Co sebou: Rope Dart\r\nUž znáš východ slunce? Velký! Pojďme se ponořit hlouběji. Ukážu vám spoustu různých variací, které jsem objevil a které vám pomohou najít kreativnější tok a inspirují vás k vytváření vlastních triků a komb. \"Tohle zvládnu. Zvládnu tamto. Proč neudělat obojí?\" \"Můžu udělat tento směr. Existuje jiný?\"", "description_EN": "IG: @darkari.motion, What to bring: Rope Dart\r\nYou know the sunrise already? Great! Let’s dive deeper. I’ll show you a lot of different variations that I discovered which help you find a more creative flow and inspire you to create your own tricks and combos. “I can do this. I can do that. Why not do both?” “I can do this direction. Is there another?”", "start": "2025-08-15T15:00:00.0000000+02:00", "end": "2025-08-15T16:30:00.0000000+02:00", "image": null, "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "0b6cd902-494b-454b-a291-aa0fb3a0f7d5", "tags": [{"id": "45d628ea-15e5-444b-a8a6-b624d86d002b", "name": "Středně pokročilí", "name_EN":"Intermediate"}]
