"id": "2851cf8e-177f-45ef-996a-acb0dabcc84c", "place":{"id": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "name": "Spinning @ Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8faa748d-f704-492f-b05a-8bb89c9a522a", "name": "Tanec/Pohyb", "name_EN":"Dance/Movement", "color": "#E3D08C"}, "name": "Floorwork for Flow Artists", "name_EN": "Floorwork for Flow Artists", "name_Secondary": "Akira Mora", "description": "IG: @akiramor_a, Co sebou: dlouhé kalhoty, triko, chrániče kolen (volitelné)\r\nBudeme izolovat pozemní pohyb, abychom vytvořili kontrolu, plynulost a spojení pro podlahové práce s rekvizitami. Očekávejte kotouly, oblouky, přechody a vzory vycházející ze současného tance a jemné akrobacie. Žádné rekvizity během hodiny, ale většina pohybů bude obsahovat příklady s různými rekvizitami, které ukazují jejich použití. Dokončíme krátkou sekvencí, abychom to spojili.\r\n", "description_EN": "IG: @akiramor_a, What to bring: long pants, tee shirt, knee pads (optional)\r\nWe’ll isolate ground-based movement to build control, fluidity, and connection for floorwork with props. Expect rolls, arching, transitions, and patterns drawn from contemporary dance and soft acrobatics. No props during class, but most movements will include examples with different props to show their application. We’ll finish with a short sequence to tie it together.\r\n", "start": "2025-08-14T13:30:00.0000000+02:00", "end": "2025-08-14T15:00:00.0000000+02:00", "image": null, "placeId": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "typeId": "8faa748d-f704-492f-b05a-8bb89c9a522a", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
},{"id": "28aea882-3367-4570-ae73-c99076243454", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Intro to Martial Staff", "name_EN": "Intro to Martial Staff", "name_Secondary": "Midori Ryans\r\n", "description": "IG: @firequeen.of.bohemia, Co sebou: Personál\r\n", "description_EN": "IG: @firequeen.of.bohemia, What to bring: Staff\r\n", "start": "2025-08-15T10:30:00.0000000+02:00", "end": "2025-08-15T12:00:00.0000000+02:00", "image": null, "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "ba7623dc-5239-49d6-9b7c-5a56d8bf4b02", "name": "Začátečníci", "name_EN":"Beginner"}]},{
"id": "29f34b92-cf0a-415d-9e0d-b83991736a1d", "place":{"id": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "name": "Spinning @ Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "ae6c4550-5f1e-4ffb-8b81-f88e4668f40a", "name": "Yoga", "name_EN":"Yoga", "color": "#FFB451"}, "name": "Kundalini Yoga", "name_EN": "Kundalini Yoga", "name_Secondary": "", "description": "\nIG: @onkar4vitalityandjoy What to bring: Yoga mat\nImprove balance and strength whilst building resilience and compassion with Kundalini Yoga.\n", "description_EN": "IG: @onkar4vitalityandjoy What to bring: Yoga mat\nImprove balance and strength whilst building resilience and compassion with Kundalini Yoga.", "start": "2025-08-17T10:00:00+02:00", "end": "2025-08-17T12:30:00+02:00", "image": "", "placeId": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "typeId": "ae6c4550-5f1e-4ffb-8b81-f88e4668f40a", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
},{"id": "2aed7c1a-17ae-42f2-a800-6c4b0bae1357", "place":{"id": "0a759b58-84dc-46c3-9833-4a1c4b80b84c", "name": "Aerial Dome", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "cd55fbd9-0c00-43fb-8a65-90097bc8d043", "name": "Acro", "name_EN":"Acro", "color": "#82735C"}, "name": "Acroyoga Flow", "name_EN": "Acroyoga Flow", "name_Secondary": "Daniel & Linaya", "description": "Balancujte. Válejte se. Protahujte se. Opakujte. Zahřejeme se základy akro a pak je propojíme s hravým rytmem praní prádla.", "description_EN": "Balance. Roll. Stretch. Repeat. We’ll warm up with solid acro basics, then link them into a playful washing-machine flow", "start": "2025-08-15T15:00:00+02:00", "end": "2025-08-15T16:30:00+02:00", "image": "", "placeId": "0a759b58-84dc-46c3-9833-4a1c4b80b84c", "typeId": "cd55fbd9-0c00-43fb-8a65-90097bc8d043", "tags": []},{
"id": "2c8245e7-c245-42e4-ba05-cef41dc67536", "place":{"id": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "name": "Spinning @ Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8faa748d-f704-492f-b05a-8bb89c9a522a", "name": "Tanec/Pohyb", "name_EN":"Dance/Movement", "color": "#E3D08C"}, "name": "Tribal dance fusion", "name_EN": "Tribal dance fusion", "name_Secondary": "Tereza Oršulíková", "description": "IG: @terraaqabal, Co sebou: Sebe\r\nSpojení technik břišního tance a tribal dance s expresivním pohybem a vyprávěním umožňuje hlouběji poznat sebe a své tělo, zkoumat funkčnost a estetiku celého těla i prozkoumat vnitřní alchymii odehrávající se v tanci, jemnost a sílu, citlivost, fantazii a představivost. Vhodné pro kohokoli, nepotřebujete předchozí zkušenosti, pouze vaši zvědavost a ochotu objevovat a bavit se.", "description_EN": "IG: @terraaqabal, What to bring: Yourself\r\nFusion of belly dance and tribal dance techniques with expressive movement and storytelling allows to get to know yourself and your body on a deeper level, researching functionality and aesthetics of the whole body as well as exploring the inner alchemy happening in the dance, softness and power, sensitivity, fantasy and imagination. Suitable for anybody, no need for previous experience, only your curiosity and willingness to explore and have fun.", "start": "2025-08-14T15:00:00+02:00", "end": "2025-08-14T16:30:00+02:00", "image": "", "placeId": "2ed3e877-836d-4f11-9965-ff31c9ccb455", "typeId": "8faa748d-f704-492f-b05a-8bb89c9a522a", "tags": [{"id": "eebd10bd-28bb-4444-8257-45487aba7c35", "name": "Všechny úrovně", "name_EN":"Open Level"}]
},{
"id": "2ecbf636-0124-4a62-8540-622fba47b33e", "place":{"id": "11eec21d-ca1d-440c-9222-993490773ee7", "name": "Forest", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "cd55fbd9-0c00-43fb-8a65-90097bc8d043", "name": "Acro", "name_EN":"Acro", "color": "#82735C"}, "name": "One with the ball", "name_EN": "One with the ball", "name_Secondary": "Van-Kim Tran - Cie Monad", "description": "IG: @CieMonad, Co sebou: kontaktní míč\r\nPoužitím principů Tai Ji v kontaktním žonglování se budeme snažit sjednotit tělo, pohyb a předmět. Zhuštěná verze našeho zářijového 5denního workshopu kontaktního žonglování!", "description_EN": "IG: @CieMonad, What to bring: contact ball\r\nBy using Tai Ji principles in contact juggling, we will look to unify the body, the movement and the object. A condensed version of our September 5-day workshop of contact juggling!", "start": "2025-08-16T09:00:00.0000000+02:00", "end": "2025-08-16T10:30:00.0000000+02:00", "image": null, "placeId": "11eec21d-ca1d-440c-9222-993490773ee7", "typeId": "cd55fbd9-0c00-43fb-8a65-90097bc8d043", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
},{"id": "30797f36-0d8f-4df0-bb26-6ef793d8c838", "place":{"id": "0a759b58-84dc-46c3-9833-4a1c4b80b84c", "name": "Aerial Dome", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "805ca0a6-de05-4fee-a0ea-61602e8a2559", "name": "Aerial", "name_EN":"Aerial", "color": "#92CBFF"}, "name": "Aerial Silks", "name_EN": "Aerial Silks", "name_Secondary": "FLORENCE Noirhomme", "description": "IG: @noirhcreativity, Co sebou: dlouhé rukávy a kalhoty\r\n", "description_EN": "IG: @noirhcreativity, What to bring: long sleeves and pants\r\n", "start": "2025-08-17T15:00:00.0000000+02:00", "end": "2025-08-17T16:30:00.0000000+02:00", "image": null, "placeId": "0a759b58-84dc-46c3-9833-4a1c4b80b84c", "typeId": "805ca0a6-de05-4fee-a0ea-61602e8a2559", "tags": [{"id": "ba7623dc-5239-49d6-9b7c-5a56d8bf4b02", "name": "Začátečníci", "name_EN":"Beginner"}]},{
"id": "32aed55a-815b-4f58-9046-b62d8a95bdbf", "place":{"id": "f15dabd2-1383-4338-8a1f-06686ae32ad9", "name": "Psylo Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "0b6cd902-494b-454b-a291-aa0fb3a0f7d5", "name": "Rope dart", "name_EN":"Rope dart", "color": "#F7DF69"}, "name": "All the Neck Wraps", "name_EN": "All the Neck Wraps", "name_Secondary": "Radi Flows", "description": "IG: @radi_flows\n\nTento workshop se zaměří na různé druhy obmotávání krku, kontinuální obmotávání krku, otočky a údery z obmotávání krku.\n\nNěkteré pohyby pak umožní provádět je současně oběma rukama, a budou tak integrovány do dvojitého toku osnov.", "description_EN": "IG: @radi_flows\n\nThis workshop will focuses on a variety of different neck wraps, continous neck wraps, turns and shots from neckwrap.\n\nSome moves will then open the possibility to be performed simultaneously with both hands, being integrated in a double staff flow.", "start": "2025-08-17T13:30:00+02:00", "end": "2025-08-17T15:00:00+02:00", "image": "", "placeId": "f15dabd2-1383-4338-8a1f-06686ae32ad9", "typeId": "0b6cd902-494b-454b-a291-aa0fb3a0f7d5", "tags": []
