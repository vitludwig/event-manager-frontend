"id": "89fede13-3ff2-4ccb-91b6-f91e89be89cc", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "Cyrill", "name_EN": "Cyrill", "name_Secondary": "", "description": "Ahoj, já jsem Cyrill, DJ ze Švýcarska, který rád hraje různé druhy hudebních žánrů. Během roku často hraji na party můj oblíbený skákací styl Zenon/Darkprog nebo Psyprog. Také hraji na všech národních akcích Flowarts ve Švýcarsku a stále více na mezinárodních akcích Psydub/Psychill/Downtempo. Těšíme se, že si opět zahrajeme v mocném Roztoči!\r\n", "description_EN": "Hey I‘m Cyrill, a DJ from Switzerland enjoying to play many different kinds of music genres. During the year I often play at parties my my favorite bouncy style of Zenon/Darkprog or Psyprog. Also I play at all the national Flowarts events in Switzerland trippy and flowy Psydub/Psychill/Downtempo as well more and more at international events. Looking forward to play again at the mighty Roztoč!\r\n", "start": "2025-08-16T23:30:00.0000000+02:00", "end": "2025-08-17T01:00:00.0000000+02:00", "image": null, "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
