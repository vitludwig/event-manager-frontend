"id": "bee829b5-e28a-4966-8903-f75644bb0763", "place":{"id": "5db9a114-6861-494a-9ba5-abc0f93ac6e8", "name": "Meadow", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "cad9ef0a-f382-406d-85fc-e8a7686b7a4f", "name": "Poi", "name_EN":"Poi", "color": "#b4d576"}, "name": "Intro to 3d", "name_EN": "Intro to 3d", "name_Secondary": "Itai Sharvit", "description": "IG: , Co sebou: Poi\r\nVezmeme plochý svět kol a nástěnných rovin a začneme jej míchat do nádherného trojrozměrného světa, ve kterém žijeme", "description_EN": "IG: , What to bring: Poi\r\nWe’ll take the flat world of wheel and wall planes and start mixing it up to the beautiful three dimensional world that we live in", "start": "2025-08-16T16:30:00+02:00", "end": "2025-08-16T18:00:00+02:00", "image": "", "placeId": "5db9a114-6861-494a-9ba5-abc0f93ac6e8", "typeId": "cad9ef0a-f382-406d-85fc-e8a7686b7a4f", "tags": [{"id": "45d628ea-15e5-444b-a8a6-b624d86d002b", "name": "Středně pokročilí", "name_EN":"Intermediate"}]
