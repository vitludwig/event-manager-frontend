"id": "3dd32cfe-b435-42ad-b3bf-7cf7b6cf102e", "place":{"id": "5f32ef9b-d255-4420-95be-101ba551381c", "name": "Dock", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "Stibbons", "name_EN": "Stibbons", "name_Secondary": "", "description": "Stibbons (Stefan) je vášnivý žonglér/flower a milovník basové hudby. Obvykle hraje světovou hudbu, těžké basové melodie pro ohnivé prostory, přinese chutnou směs špinavého dubstepu a hlubokého dnb, aby se vám v bunkru roztřásly zadky!\r\n", "description_EN": "Stibbons (Stefan) is a passionate juggler/flow artist and lover of bass music. Usually playing world music infused, bass heavy tunes for firespaces, he’ll bring a flavorful mix of grimy dubstep and deep dnb to get your butts shaking in the bunker!\r\n", "start": "2025-08-16T01:00:00.0000000+02:00", "end": "2025-08-16T02:30:00.0000000+02:00", "image": null, "placeId": "5f32ef9b-d255-4420-95be-101ba551381c", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
