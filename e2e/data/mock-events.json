"id": "b48596ce-9e2f-4182-bd55-c2d7a21893d9", "place":{"id": "11eec21d-ca1d-440c-9222-993490773ee7", "name": "Forest", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "ae6c4550-5f1e-4ffb-8b81-f88e4668f40a", "name": "Yoga", "name_EN":"Yoga", "color": "#FFB451"}, "name": "Tai Ji moving meditation", "name_EN": "Tai Ji moving meditation", "name_Secondary": "Van-Kim Tran - Cie Monad", "description": "IG: @CieMonad, Co sebou: sebe\r\nPohybová meditace Tai Ji Tao je způsob, jak sjednotit tělo a mysl. Prostřednictvím opakování jednoduchých forem si procvičíme zvyšování tělesného a pohybového povědomí. Je to skvělá podpora pro jakýkoli cirkusový trénink. Mezi další praktikující tohoto stylu, které možná znáte, patří Ronan Mc Loughlin a Meast/Romain Marguaritte", "description_EN": "IG: @CieMonad, What to bring: yourself\r\nTai Ji Tao moving meditation is a way to unify the body and the mind. Through the repetition of simple forms, we will practice increasing body and movement awareness. It is a great support for any circus training. Other practitionners of this style that you may know includes Ronan Mc Loughlin and Meast/Romain Marguaritte", "start": "2025-08-17T10:30:00.0000000+02:00", "end": "2025-08-17T12:00:00.0000000+02:00", "image": null, "placeId": "11eec21d-ca1d-440c-9222-993490773ee7", "typeId": "ae6c4550-5f1e-4ffb-8b81-f88e4668f40a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
