},{"id": "7ce916eb-ecea-4dc4-b5f2-60caaf9b56b1", "place":{"id": "f049336d-e8e1-4ef2-bd15-94105f467fce", "name": "Beach", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "4bf40ee3-a45a-4446-800f-73f6731d61e9", "name": "Fun", "name_EN":"Fun", "color": "#a64d79"}, "name": "Ding Dong Championship", "name_EN": "Ding Dong Championship", "name_Secondary": "", "description": "Přijďte nám předvést, jaké schopnosti házení jste získali během nocí v Roztoči! Nezapomeňte se přihlásit!", "description_EN": "Come and show us the willy-throwing skill you've gained during the nights at Roztoč! Don't forget to sign up!", "start": "2025-08-17T21:30:00+02:00", "end": "2025-08-17T23:00:00+02:00", "image": "", "placeId": "f049336d-e8e1-4ef2-bd15-94105f467fce", "typeId": "4bf40ee3-a45a-4446-800f-73f6731d61e9", "tags": []},{"id": "802a6e1f-acc5-4bbc-bae4-ef9612fcc313", "place":{"id": "7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18", "name": "Tchaiovna", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "eb6f9406-ec4e-4362-bc82-4a0e494fb189", "name": "Show", "name_EN":"Show", "color": "#e99998"}, "name": "Divadlo pro děti", "name_EN": "Kids' theatre", "name_Secondary": "", "description": "Divadlo pro děti", "description_EN": "Kids' theatre", "start": "2025-08-17T11:00:00+02:00", "end": "2025-08-17T12:00:00+02:00", "image": "", "placeId": "7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18", "typeId": "eb6f9406-ec4e-4362-bc82-4a0e494fb189", "tags": []},{
"id": "80377270-047b-4039-8dc3-2becf6a4e7bc", "place":{"id": "7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18", "name": "Tchaiovna", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "DJ Usagi", "name_EN": "DJ Usagi", "name_Secondary": "", "description": "Od Bristolu po Brno přináší skákací basový zajíček beaty a bangery, kamkoli přijdou. Hraní všeho od hiphopu přes disco po electroswing až po britskou garáž a drum and bass, jediná věc, která je zaručena, je zábava a hloupost. \r\n", "description_EN": "From Bristol to Brno, the bouncy bass bunny brings beats and bangers wherever they go. Playing everything from hiphop to disco to electroswing to UK garage and drum and bass, the only thing that is guaranteed is fun and sillyness. \r\n", "start": "2025-08-15T00:00:00+02:00", "end": "2025-08-15T02:30:00+02:00", "image": "", "placeId": "7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
},{
"id": "806401fd-47d3-4fca-b1a8-b17f2cb15967", "place":{"id": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "name": "Fire Space", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8b844ab4-dc39-4323-b647-e93bfb43d2b8", "name": "Gala", "name_EN":"Gala", "color": "#ffe59a"}, "name": "Fire gala", "name_EN": "Fire gala", "name_Secondary": "", "description": "Ohňové gala vás dostane do vytržení neotřelými hračkami, dechberoucími choreografiemi, a uměleckým procítěním každého čísla propojeného s tím nejžhavějším prvkem.\r\n\r\nÚČINKUJÍCÍ:\r\nMr Bang! - uvází\r\nSrikanta Barefoot\r\nSimone Modafferi\r\nTalon\r\nLilith\r\nGuillaume\r\nCharlie Nayler\r\nSara Luna\r\nKrista Palm", "description_EN": "The Fire gala will take our breath away with novel props, incredible choreographies, and wild artistry linked to the hottest element. MC'd by the glorious Mr. Bang!, enjoyment is guaranteed!\r\n\r\nLINEUP:\r\nMr Bang!\r\nSrikanta Barefoot\r\nSimone Modafferi\r\nTalon\r\nLilith\r\nGuillaume\r\nCharlie Nayler\r\nSara Luna\r\nKrista Palm", "start": "2025-08-15T20:30:00.0000000+02:00", "end": "2025-08-15T21:30:00.0000000+02:00", "image": null, "placeId": "23c4fbee-6ebb-4b05-ad05-a5ad8d2d5022", "typeId": "8b844ab4-dc39-4323-b647-e93bfb43d2b8", "tags": []
},{
"id": "80a8cc88-b9f1-4f19-a9d1-8fc351688c67", "place":{"id": "f15dabd2-1383-4338-8a1f-06686ae32ad9", "name": "Psylo Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "name": "Všechny tyče", "name_EN":"All staffs", "color": "#7289F0"}, "name": "Long string Leviwand", "name_EN": "Long string Leviwand", "name_Secondary": "Zuzka", "description": "IG: @thezukeeper, Co sebou: Leviwand (mám jen pár náhradních)\r\nProbereme řadu základních, ale magicky vypadajících triků a pohybů, možná i nějaký ten kontakt. Nejsou nutné předchozí zkušenosti.", "description_EN": "IG: @thezukeeper, What to bring: Leviwand (I only got a few spare)\r\nWe will cover a number of basic but magical-looking tricks and moves, maybe even some contact. No previous experience necessary.", "start": "2025-08-17T16:30:00.0000000+02:00", "end": "2025-08-17T18:00:00.0000000+02:00", "image": null, "placeId": "f15dabd2-1383-4338-8a1f-06686ae32ad9", "typeId": "e7fc379a-08b6-4c55-bf80-ab739a49cb3a", "tags": [{"id": "ba7623dc-5239-49d6-9b7c-5a56d8bf4b02", "name": "Začátečníci", "name_EN":"Beginner"}]
