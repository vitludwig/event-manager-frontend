"id": "fdd779b0-79f4-45fb-89e6-4cc4f55eccb8", "place":{"id": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "name": "Circus Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "2a8fa9ce-b0d9-4bea-afb1-e07efd0211de", "name": "Lecture/Performance presence", "name_EN":"Lecture/Performance presence", "color": ""}, "name": "Performance and Presence", "name_EN": "Performance and Presence", "name_Secondary": "Ian Deady", "description": "IG: @iandeadly, Co sebou: Sebe\r\nPohled na to, jak využít prostor jako performer, jak upoutat pozornost publika. Načasování, pohyb a vztah k vaší veřejnosti. Přizpůsobeno speciálně pro oheň a průtok.", "description_EN": "IG: @iandeadly, What to bring: Yourself\r\nLooking at how to use the space as a performer, how to capture attention from the audience. Timing, movement and relation to your public. Adapted specifically for fire and flow performance.", "start": "2025-08-16T10:30:00+02:00", "end": "2025-08-16T12:00:00+02:00", "image": "", "placeId": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "typeId": "2a8fa9ce-b0d9-4bea-afb1-e07efd0211de", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
},{
"id": "fe959ca7-83c8-4180-932b-8ff4ddf02275", "place":{"id": "5f32ef9b-d255-4420-95be-101ba551381c", "name": "Dock", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "BZarr", "name_EN": "BZarr", "name_Secondary": "", "description": "Bzarr – je příjemné být zpět na jednom z nejlepších festivalů v Evropě! Přinášíme vám svěží basovou hudbu z různých částí světa. Nechte tu věc trochu divnou. Buďte bizarní!\r\n", "description_EN": "Bzarr – its nice to be back for one of the coolest festivals in Europe ! Bringing some fresh bass music from different parts of the world for you. Keep thing little bit weird. Be Bizarre!\r\n", "start": "2025-08-16T04:00:00.0000000+02:00", "end": "2025-08-16T06:00:00.0000000+02:00", "image": null, "placeId": "5f32ef9b-d255-4420-95be-101ba551381c", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
