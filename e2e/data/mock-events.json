"id": "91b2ae72-4dda-40ad-a959-c5ce026300e8", "place":{"id": "5db9a114-6861-494a-9ba5-abc0f93ac6e8", "name": "Meadow", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "cad9ef0a-f382-406d-85fc-e8a7686b7a4f", "name": "Poi", "name_EN":"Poi", "color": "#b4d576"}, "name": "Poi juggling with switchbacks", "name_EN": "Poi juggling with switchbacks", "name_Secondary": "Stefan", "description": "IG: @hohenberger.stefan, Co sebou: Poi\r\nProzkoumejte, jak začlenit serpentiny do žonglérských vzorů. Zaměříme se na 3 Poi, ale jako základ se ponoříme také do variant 2 Poi.", "description_EN": "IG: @hohenberger.stefan, What to bring: Poi\r\nExplore how to incorporate switchbacks into juggling patterns. Focus will be on 3 poi, but we will also dive into 2 Poi variations as a basis.", "start": "2025-08-16T12:00:00.0000000+02:00", "end": "2025-08-16T13:30:00.0000000+02:00", "image": null, "placeId": "5db9a114-6861-494a-9ba5-abc0f93ac6e8", "typeId": "cad9ef0a-f382-406d-85fc-e8a7686b7a4f", "tags": [{"id": "45d628ea-15e5-444b-a8a6-b624d86d002b", "name": "Středně pokročilí", "name_EN":"Intermediate"}]
