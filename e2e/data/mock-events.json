"id": "c38394d6-f9fa-4c54-b925-0bd1a95ac5a7", "place":{"id": "0a759b58-84dc-46c3-9833-4a1c4b80b84c", "name": "Aerial Dome", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "805ca0a6-de05-4fee-a0ea-61602e8a2559", "name": "Aerial", "name_EN":"Aerial", "color": "#92CBFF"}, "name": "Rope - Fun&Dynamics", "name_EN": "Rope - Fun&Dynamics", "name_Secondary": "Airene ", "description": "IG: Airene_Aerialdance\nCo si s sebou vzít: Terraband nebo gumičku, tréninkové oblečení a zakryté břicho\n\nSe specifickým rozcvičením, nácvik dynamických rolování a zábavných variací. Pro středně pokročilé a pokročilé letecké atletisty, se silným základem.", "description_EN": "IG: Airene_Aerialdance\nWhat to bring: Terraband or elastic band, trainings clothes and belly covered\n\n\nWith a specific warmup, practice dynamics roll ups and fun variations. For intermediate and advanced aerialists, with strong foundation.", "start": "2025-08-14T12:00:00+02:00", "end": "2025-08-14T13:30:00+02:00", "image": "", "placeId": "0a759b58-84dc-46c3-9833-4a1c4b80b84c", "typeId": "805ca0a6-de05-4fee-a0ea-61602e8a2559", "tags": [{"id": "a9a103c8-c8bf-4e98-9dce-ddada98d71c1", "name": "Pokročilí", "name_EN":"Advanced"}]
},{
"id": "c43e330d-9567-46e6-8d5c-0ef0014f8396", "place":{"id": "7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18", "name": "Tchaiovna", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "fecad87f-08cd-48ef-952c-b72fdc3fe775", "name": "Live music", "name_EN":"Live music", "color": "#43e90c"}, "name": "Gift horses", "name_EN": "Gift horses", "name_Secondary": "", "description": "Dárkové koně plynule proklouzávají mezi mandinskými melodiemi a písněmi do angličtiny, francouzštiny, gaelštiny, češtiny, ruštiny a dalších. Přidejte kapky vyprávění a máte mezikulturní duet. Jejich koncerty jsou jako putování světem v batohu.\r\n", "description_EN": "The gift horses slip seamlessly between Mandinka melodies and songs to English, French, Gaelic, Czech, Russian, and more. Add dashes of story telling and you have a cross cultural duet. Their concerts are like roving the world in their backpack.\r\n", "start": "2025-08-17T14:30:00.0000000+02:00", "end": "2025-08-17T15:30:00.0000000+02:00", "image": null, "placeId": "7f56de3c-ae91-4bc3-8d2c-a9b4fd401b18", "typeId": "fecad87f-08cd-48ef-952c-b72fdc3fe775", "tags": []
},{
"id": "c536ba20-c5a2-4048-b2b9-a60702e9e219", "place":{"id": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "name": "Circus Tent", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "8faa748d-f704-492f-b05a-8bb89c9a522a", "name": "Tanec/Pohyb", "name_EN":"Dance/Movement", "color": "#E3D08C"}, "name": "Body Control", "name_EN": "Body Control", "name_Secondary": "Ambra", "description": "IG: @ambra_occhipinti, Co sebou: energie!\r\nZdokonalte svůj pohyb pomocí ovládání těla, vln a technik navlékání. Naučte se vést energii vlnami paží a těla, plynule sledovat a navlékat, abyste ve svém tanci vytvořili plynulý, záměrný pohyb.", "description_EN": "IG: @ambra_occhipinti, What to bring: energy!\r\nRefine your movement with body control, waves, and threading techniques. Learn to guide energy through arms and body waves, seamlessly tracing and threading to create fluid, intentional motion in your dance.", "start": "2025-08-14T15:00:00.0000000+02:00", "end": "2025-08-14T16:30:00.0000000+02:00", "image": null, "placeId": "78007c5c-0e02-4b1b-b364-86bfedf1ba99", "typeId": "8faa748d-f704-492f-b05a-8bb89c9a522a", "tags": [{"id": "35f1e8bc-7735-43fb-8caa-5d87e940a8b3", "name": "Masterclass", "name_EN":"Masterclass"}]
