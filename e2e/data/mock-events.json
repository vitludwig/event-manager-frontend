"id": "61e21fca-d4c0-4ea7-87af-a428f0d34778", "place":{"id": "5f32ef9b-d255-4420-95be-101ba551381c", "name": "Dock", "name_EN":"", "name_Secondary": "", "description": "","description_EN": "", "start": null, "end":null, "image": "", "placeId": "00000000-0000-0000-0000-000000000000","typeId": "00000000-0000-0000-0000-000000000000", "tags": []}, "type":{"id": "caa27447-9336-402c-b8f7-b00b8b5476f8", "name": "DJ", "name_EN":"DJ", "color": "#c9daf8"}, "name": "PFX", "name_EN": "PFX", "name_Secondary": "", "description": "S temnými přestávkami, kmenovými rytmy a plynulými zvukovými plochami vytváří PFX žánrově rozmazaný zvuk. Ovlivněn dubem, junglem a britskou basou, obratně žongluje se svým voskem, aby vytvořil nečekané cesty hlubokými, basy poháněnými a hypnotickými atmosférami.", "description_EN": "With dark breaks, tribal rhythms, and flowing soundscapes, PFX crafts a genre-blurring sound. Influenced by dub, jungle, and UK bass, he deftly juggles his wax to create unexpected journeys through deep, bass-driven, and hypnotic atmospheres.", "start": "2025-08-15T23:30:00.0000000+02:00", "end": "2025-08-16T01:00:00.0000000+02:00", "image": null, "placeId": "5f32ef9b-d255-4420-95be-101ba551381c", "typeId": "caa27447-9336-402c-b8f7-b00b8b5476f8", "tags": []
