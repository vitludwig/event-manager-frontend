{
  "name": "event-program",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:android": "ng build --configuration development-android",
    "build:ios": "ng build --configuration development-ios",
    "build:mobile": "ng build --configuration production",
    "test": "CHROME_BIN=/opt/google/chrome/google-chrome npx ng test --watch=false",
    "lint": "ng lint",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android": "npm run build:android && npm run cap:sync:android && npm run cap:open:android",
    "ios": "npm run build:ios && npm run cap:sync:ios && npm run cap:open:ios",
    "android:prod": "npm run build:mobile && npm run cap:sync:android && npm run cap:open:android",
    "ios:prod": "npm run build:mobile && npm run cap:sync:ios && npm run cap:open:ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.5",
    "@angular/cdk": "^21.0.3",
    "@angular/common": "^21.0.5",
    "@angular/compiler": "^21.0.5",
    "@angular/core": "^21.0.5",
    "@angular/forms": "^21.0.5",
    "@angular/material": "^21.0.3",
    "@angular/platform-browser": "^21.0.5",
    "@angular/platform-browser-dynamic": "^21.0.5",
    "@angular/router": "^21.0.5",
    "@angular/service-worker": "^21.0.5",
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/local-notifications": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@meddv/ngx-pinch-zoom": "^20.0.0",
    "@microsoft/signalr": "^7.0.5",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@types/signalr": "^2.4.0",
    "@zxing/ngx-scanner": "^21.0.0",
    "dayjs": "^1.11.7",
    "ng-qrcode": "^21.0.0",
    "onesignal-cordova-plugin": "^5.2.13",
    "rxjs": "~7.8.0",
    "short-uuid": "^5.2.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.1.0",
    "@angular-eslint/eslint-plugin": "^21.1.0",
    "@angular-eslint/eslint-plugin-template": "^21.1.0",
    "@angular-eslint/schematics": "^21.1.0",
    "@angular-eslint/template-parser": "^21.1.0",
    "@angular/build": "^21.0.3",
    "@angular/cli": "~21.0.3",
    "@angular/compiler-cli": "^21.0.5",
    "@angular/localize": "^21.0.5",
    "@capacitor/cli": "^7.2.0",
    "@playwright/test": "^1.58.2",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.53.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.9.3"
  }
}
